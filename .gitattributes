# Fuerza LF en todo lo que se ejecuta o se lee dentro de contenedores Linux.
# Sin esto, con core.autocrlf=true en Windows un .sh acaba con CRLF y el VPS
# responde: "/bin/bash^M: bad interpreter: No such file or directory".
*.sh    text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.xml   text eol=lf
*.csv   text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
