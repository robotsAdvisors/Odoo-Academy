<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academy_decision_flow_list" model="ir.ui.view">
        <field name="name">academy.decision.flow.list</field>
        <field name="model">academy.decision.flow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="points_reward"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_academy_fundador_digital_url" model="ir.actions.act_url">
        <field name="name">Fundador Digital Interactivo</field>
        <field name="url">/web/academy/fundador-digital</field>
        <field name="target">self</field>
    </record>

    <record id="view_academy_decision_flow_form" model="ir.ui.view">
        <field name="name">academy.decision.flow.form</field>
        <field name="model">academy.decision.flow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Probar Flujo Interactivo" type="action" name="%(action_academy_fundador_digital_url)d" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="points_reward"/>
                    </group>
                    <group>
                        <field name="level1_ecommerce_channel_id"/>
                        <field name="level1_hospitality_channel_id"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Questions">
                            <field name="question_ids" context="{'default_flow_id': id}">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="title"/>
                                    <field name="is_start"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="title"/>
                                        <field name="help_text"/>
                                        <field name="is_start"/>
                                    </group>
                                    <field name="option_ids" context="{'default_question_id': id}">
                                        <list editable="bottom">
                                            <field name="sequence"/>
                                            <field name="label"/>
                                            <field name="next_question_id"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_academy_decision_flow" model="ir.actions.act_window">
        <field name="name">Decision Flows</field>
        <field name="res_model">academy.decision.flow</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_academy_decision_session_list" model="ir.ui.view">
        <field name="name">academy.decision.session.list</field>
        <field name="model">academy.decision.session</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="create_date desc">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="flow_id"/>
                <field name="state"/>
                <field name="edition_recommendation"/>
                <field name="track_recommendation"/>
                <field name="architecture_recommendation"/>
            </list>
        </field>
    </record>

    <record id="view_academy_decision_session_form" model="ir.ui.view">
        <field name="name">academy.decision.session.form</field>
        <field name="model">academy.decision.session</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="flow_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="edition_recommendation" readonly="1"/>
                            <field name="architecture_recommendation" readonly="1"/>
                            <field name="track_recommendation" readonly="1"/>
                            <field name="report_attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="result_summary" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Scores">
                        <field name="community_score" readonly="1"/>
                        <field name="enterprise_score" readonly="1"/>
                        <field name="ecommerce_score" readonly="1"/>
                        <field name="hospitality_score" readonly="1"/>
                        <field name="simple_score" readonly="1"/>
                        <field name="control_score" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Answers">
                            <field name="answer_ids" readonly="1">
                                <list>
                                    <field name="question_id"/>
                                    <field name="option_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_academy_decision_session" model="ir.actions.act_window">
        <field name="name">Decision Sessions</field>
        <field name="res_model">academy.decision.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_academy_fundador_digital" name="Fundador Digital (Interactivo)" parent="menu_academy_gamification_root" action="action_academy_fundador_digital_url" sequence="30" groups="base.group_user"/>
    <menuitem id="menu_academy_decision_flow" name="Decision Flows" parent="menu_academy_gamification_root" action="action_academy_decision_flow" sequence="40" groups="base.group_user"/>
    <menuitem id="menu_academy_decision_session" name="Decision Sessions" parent="menu_academy_gamification_root" action="action_academy_decision_session" sequence="50" groups="base.group_user"/>
</odoo>
