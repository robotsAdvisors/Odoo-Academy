<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         Formulario de inscripción (paso previo al pago)
    ══════════════════════════════════════════════════ -->
    <template id="academy_inscripcion_form" name="Academy – Formulario de inscripción">
        <t t-call="website.layout">
            <t t-set="head">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link href="https://fonts.googleapis.com/css2?family=Sora:wght@700;800&amp;family=IBM+Plex+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
                <style>
                    .insc-wrap {
                        min-height: 100vh;
                        background: radial-gradient(900px 400px at 50% 0%, #bbf7d0 0%, transparent 60%), #f6f4ef;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 48px 16px;
                        font-family: 'IBM Plex Sans', sans-serif;
                    }
                    .insc-card {
                        background: #ffffff;
                        border: 1px solid #d4d4d8;
                        border-radius: 1.4rem;
                        padding: 2.5rem 2rem;
                        max-width: 480px;
                        width: 100%;
                        box-shadow: 0 4px 24px rgba(0,0,0,.06);
                    }
                    .insc-badge {
                        display: inline-block;
                        background: #d1fae5;
                        color: #065f46;
                        font-size: .8rem;
                        font-weight: 600;
                        padding: .3rem .8rem;
                        border-radius: 999px;
                        margin-bottom: 1rem;
                    }
                    .insc-title {
                        font-family: 'Sora', sans-serif;
                        font-size: 1.6rem;
                        font-weight: 800;
                        color: #111827;
                        margin-bottom: .5rem;
                    }
                    .insc-sub {
                        color: #6b7280;
                        font-size: .95rem;
                        margin-bottom: 1.8rem;
                    }
                    .insc-label {
                        display: block;
                        font-size: .85rem;
                        font-weight: 600;
                        color: #374151;
                        margin-bottom: .35rem;
                    }
                    .insc-input {
                        width: 100%;
                        padding: .7rem 1rem;
                        border: 1.5px solid #d1d5db;
                        border-radius: .6rem;
                        font-size: 1rem;
                        font-family: inherit;
                        margin-bottom: 1rem;
                        transition: border-color .15s;
                        box-sizing: border-box;
                    }
                    .insc-input:focus {
                        outline: none;
                        border-color: #0f766e;
                        box-shadow: 0 0 0 3px rgba(15,118,110,.12);
                    }
                    .insc-btn {
                        width: 100%;
                        background: #0f766e;
                        color: #fff;
                        font-family: 'Sora', sans-serif;
                        font-weight: 700;
                        font-size: 1rem;
                        padding: .85rem 1.5rem;
                        border: none;
                        border-radius: .7rem;
                        cursor: pointer;
                        transition: background .15s;
                    }
                    .insc-btn:hover { background: #0d6960; }
                    .insc-price-row {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        background: #f0fdf4;
                        border: 1px solid #bbf7d0;
                        border-radius: .7rem;
                        padding: .8rem 1rem;
                        margin-bottom: 1.5rem;
                        font-size: .9rem;
                        color: #065f46;
                    }
                    .insc-price-row strong { font-size: 1.2rem; }
                    .insc-error {
                        background: #fef2f2;
                        border: 1px solid #fca5a5;
                        color: #b91c1c;
                        border-radius: .6rem;
                        padding: .7rem 1rem;
                        font-size: .88rem;
                        margin-bottom: 1rem;
                    }
                    .insc-secure {
                        text-align: center;
                        color: #9ca3af;
                        font-size: .78rem;
                        margin-top: 1rem;
                    }
                </style>
            </t>

            <div class="insc-wrap">
                <div class="insc-card">
                    <span class="insc-badge">🎓 Precio de lanzamiento</span>
                    <h1 class="insc-title">Accede al curso<br/>Fundador Digital</h1>
                    <p class="insc-sub">Digitaliza tu negocio con Odoo. Acceso inmediato tras el pago.</p>

                    <div class="insc-price-row">
                        <span>Fundador Digital – Acceso completo</span>
                        <strong>22 €</strong>
                    </div>

                    <t t-if="error">
                        <div class="insc-error"><t t-esc="error"/></div>
                    </t>

                    <form action="/academy/inscripcion" method="POST">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <label class="insc-label" for="insc_nombre">Nombre completo</label>
                        <input class="insc-input" type="text" id="insc_nombre" name="nombre"
                               placeholder="María García"
                               t-att-value="nombre or ''"
                               required="required" autocomplete="name"/>

                        <label class="insc-label" for="insc_email">Email</label>
                        <input class="insc-input" type="email" id="insc_email" name="email"
                               placeholder="maria@tuempresa.com"
                               t-att-value="email or ''"
                               required="required" autocomplete="email"/>

                        <button type="submit" class="insc-btn">
                            Ir a pagar 22 € →
                        </button>
                    </form>

                    <p class="insc-secure">🔒 Pago seguro con Stripe · Sin suscripciones</p>
                </div>
            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════
         Página de confirmación / gracias
         (se muestra si el usuario regresa tras pagar)
    ══════════════════════════════════════════════════ -->
    <template id="academy_pago_gracias" name="Academy – Pago confirmado">
        <t t-call="website.layout">
            <t t-set="head">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link href="https://fonts.googleapis.com/css2?family=Sora:wght@700;800&amp;family=IBM+Plex+Sans:wght@400;500&amp;display=swap" rel="stylesheet"/>
                <style>
                    .gracias-wrap {
                        min-height: 80vh;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 48px 16px;
                        font-family: 'IBM Plex Sans', sans-serif;
                        background: #f6f4ef;
                    }
                    .gracias-card {
                        background: #fff;
                        border: 1px solid #d4d4d8;
                        border-radius: 1.4rem;
                        padding: 3rem 2rem;
                        max-width: 520px;
                        width: 100%;
                        text-align: center;
                        box-shadow: 0 4px 24px rgba(0,0,0,.06);
                    }
                    .gracias-icon { font-size: 3.5rem; margin-bottom: 1rem; }
                    .gracias-title {
                        font-family: 'Sora', sans-serif;
                        font-size: 1.8rem;
                        font-weight: 800;
                        color: #111827;
                        margin-bottom: .6rem;
                    }
                    .gracias-sub { color: #6b7280; font-size: 1rem; margin-bottom: 2rem; }
                    .gracias-btn {
                        display: inline-block;
                        background: #0f766e;
                        color: #fff;
                        font-family: 'Sora', sans-serif;
                        font-weight: 700;
                        font-size: 1rem;
                        padding: .85rem 2rem;
                        border-radius: .7rem;
                        text-decoration: none;
                    }
                </style>
            </t>
            <div class="gracias-wrap">
                <div class="gracias-card">
                    <div class="gracias-icon">🎉</div>
                    <h1 class="gracias-title">¡Pago confirmado!</h1>
                    <p class="gracias-sub">
                        Revisa tu bandeja de entrada. Te hemos enviado un email con las
                        instrucciones para acceder al curso.
                    </p>
                    <a href="/academy/fundador-digital" class="gracias-btn">
                        Acceder al curso →
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
