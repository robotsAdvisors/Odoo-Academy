# =============================================================
# MinIO — DESACTIVADO
#
# Para activarlo:
#   1. Crea los registros A de s3.<dominio> y minio.<dominio>
#      apuntando a este servidor.
#   2. Obtén sus certificados:
#        ./scripts/init_certs.sh <dominio> <email> s3 minio
#   3. Renombra este fichero a minio.conf y monta el directorio
#      completo nginx/ en /etc/nginx/conf.d/ (o añade el fichero
#      al volumen del servicio nginx en docker-compose.yml).
#   4. docker compose exec nginx nginx -t && docker compose exec nginx nginx -s reload
#
# Mientras s3./minio. no tengan certificado, este fichero NO debe
# cargarse: nginx aborta el arranque si un ssl_certificate no existe,
# y eso tumbaría también el sitio de Odoo.
#
# Recuerda además quitar la publicación de los puertos 9000/9001 en
# docker-compose.yml al activar esto — si no, MinIO seguirá accesible
# sin TLS directamente por IP.
# =============================================================

upstream minio_s3 {
    server minio:9000;
}

upstream minio_console {
    server minio:9001;
}

# ─────────────────────────────────────────────
# MINIO API S3  ->  s3.robotsconsultant.net
# ─────────────────────────────────────────────
server {
    listen 80;
    server_name s3.robotsconsultant.net;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name s3.robotsconsultant.net;

    ssl_certificate     /etc/letsencrypt/live/s3.robotsconsultant.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3.robotsconsultant.net/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Videos pueden ser grandes — sin límite aquí
    client_max_body_size 0;

    # Necesario para que MinIO gestione chunked uploads de S3
    ignore_invalid_headers off;
    proxy_buffering         off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://minio_s3;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        chunked_transfer_encoding on;
    }
}

# ─────────────────────────────────────────────
# MINIO CONSOLE  ->  minio.robotsconsultant.net
# ─────────────────────────────────────────────
server {
    listen 80;
    server_name minio.robotsconsultant.net;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name minio.robotsconsultant.net;

    ssl_certificate     /etc/letsencrypt/live/minio.robotsconsultant.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/minio.robotsconsultant.net/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 0;
    proxy_buffering off;

    location / {
        proxy_pass http://minio_console;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }
}
