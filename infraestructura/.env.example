# =============================================================
# Copia este fichero a .env (mismo directorio que docker-compose.yml)
# y rellena los valores. .env NO se sube a git.
#
#   cp .env.example .env
#
# Genera contraseñas con:  openssl rand -base64 30
# =============================================================

# --- Proyecto Compose ----------------------------------------
# De aquí cuelgan los nombres de los volúmenes: <proyecto>_odoo-data
# guarda el filestore (adjuntos, imágenes de los cursos). Si cambia,
# Docker crea volúmenes nuevos y vacíos y parecerá que se ha perdido
# todo. En el servidor de producción vale odoo-docker. NO LO CAMBIES.
COMPOSE_PROJECT_NAME=odoo-docker

# --- Ruta de los addons --------------------------------------
# En el repo, custom-addons está en la raíz  -> ../custom-addons
# En el servidor vive dentro del proyecto    -> ./custom-addons
ADDONS_PATH=../custom-addons

# --- PostgreSQL ----------------------------------------------
# Deben coincidir con db_user / db_password de config/odoo.conf.
# OJO: sobre un cluster YA CREADO, cambiar POSTGRES_PASSWORD aquí no
# cambia la contraseña del rol (solo se aplica en el initdb inicial).
# Para rotarla de verdad: ALTER ROLE odoo WITH PASSWORD '...';
POSTGRES_USER=odoo
POSTGRES_PASSWORD=

# --- MinIO ---------------------------------------------------
# Actualmente MinIO NO está integrado con Odoo (ningún módulo S3
# instalado, ningún parámetro configurado). Está expuesto por IP y
# sin TLS en los puertos 9000/9001.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Sin DNS para minio.<dominio>, la consola redirige a la IP.
# Cuando exista el registro A: https://minio.robotsconsultant.net
MINIO_BROWSER_REDIRECT_URL=http://161.35.127.230:9001
